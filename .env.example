# Copy this file to .env and fill in real values. Never commit .env itself.

# Anthropic API key, for the extraction and synthesis LLM calls
ANTHROPIC_API_KEY=

# The Google Sheet's ID — the long string in its URL between /d/ and /edit
GOOGLE_SHEET_ID=

# Exactly ONE of the two below:

# Path to the downloaded service-account JSON key file (for local/CLI use)
GOOGLE_SERVICE_ACCOUNT_JSON=

# Or the JSON key's raw contents as a string (for Streamlit Cloud secrets,
# where a file path isn't practical) — leave GOOGLE_SERVICE_ACCOUNT_JSON blank
# if you use this instead.
GOOGLE_SERVICE_ACCOUNT_JSON_CONTENT=

# Apify API token — only needed once a social-platform adapter is built (Part 5).
# Apify console -> Settings -> API & Integrations -> API tokens.
APIFY_TOKEN=

# Optional, later: only if we add automatic topic-to-URL discovery.
# EXA_API_KEY=

# Gmail API — the app's OWN login for the newsletter-folder feature (separate
# from any Gmail access Claude has in chat). Path to the OAuth client JSON
# downloaded from Google Cloud Console (Credentials -> OAuth client ID -> Desktop app).
GOOGLE_GMAIL_OAUTH_CLIENT=
